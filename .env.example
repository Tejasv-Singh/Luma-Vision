# ---------------------------------------------------------------------------
# Luma Vision — frontend environment configuration
# Copy to `.env.local` and adjust. Only VITE_* vars reach the browser bundle.
# ---------------------------------------------------------------------------

# Base URL of the analysis API. Leave as "/api" to use the Vite dev proxy.
VITE_API_BASE_URL=/api

# Target the dev proxy forwards /api to (backend FastAPI/Flask service).
VITE_PROXY_TARGET=http://localhost:8000

# Use the bundled mock service instead of a real backend.
# "true" -> fully offline, deterministic demo data. "false" -> real HTTP calls.
VITE_USE_MOCK_API=true

# Simulated latency (ms) for the mock API, so loading states are visible.
VITE_MOCK_LATENCY=650

# Simulated seconds the mock pipeline spends in the "analyzing" state.
VITE_MOCK_ANALYSIS_SECONDS=12

# Max accepted upload size in megabytes.
VITE_MAX_UPLOAD_MB=2048

# Request timeout in milliseconds for non-upload API calls.
VITE_API_TIMEOUT=30000
